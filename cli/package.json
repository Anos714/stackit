{
  "name": "stackit",
  "version": "0.1.0",
  "description": "Opinionated full-stack project scaffolder — MERN, PERN, Hono + Postgres, Go Fiber",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "stackit": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "build": "bun build src/index.ts --target bun --outfile dist/stackit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "picocolors": "^1.1.1",
    "yocto-spinner": "^1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
