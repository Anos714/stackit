{
  "name": "create-stackit-app",
  "version": "0.3.1",
  "description": "Opinionated full-stack project scaffolder — MERN, PERN, Hono + Postgres, Go Fiber, FastAPI, NestJS",
  "keywords": [
    "cli",
    "scaffold",
    "scaffolding",
    "generator",
    "create-app",
    "boilerplate",
    "starter",
    "template",
    "full-stack",
    "monorepo",
    "mern",
    "pern",
    "hono",
    "go",
    "fiber",
    "fastapi",
    "nestjs",
    "nextjs",
    "react",
    "vite",
    "typescript",
    "nodejs",
    "postgresql",
    "mongodb",
    "docker",
    "bun"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "stackit": "dist/stackit.js",
    "create-stackit-app": "dist/stackit.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "build": "bun build src/index.ts --target node --outfile dist/stackit.js",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "picocolors": "^1.1.1",
    "yocto-spinner": "^1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
